# Fboard-Node configuration (machine mode only)
# Top-level settings are inherited by all instances. Instance overrides take precedence.

panel:
  url: "https://panel.example.com"
machine:
  machine_id: 1
  token: "your-machine-token"
  # token_env: "MACHINE_TOKEN"   # optional: read token from env

# Optional tuning
# log:
#   level: "info"
# node:
#   push_interval: 60
#   pull_interval: 60
# kernel:
#   log_level: "warn"
#   # Per-connection xray pipe buffer in KiB (default 16). Raise for high-throughput links.
#   # buffer_size: 16
# runtime:
#   # Default GOGC is 50 (more aggressive than Go's 100) for lower RSS under churn.
#   # gogc: 50
#   # Soft memory limit — GC becomes more aggressive near this cap.
#   # gomemlimit: "512MiB"
# health_port: 65530    # HTTP /healthz endpoint port (default: 65530, 0 to disable)

# Multiple panel machines in one process:
# instances:
#   - panel:
#       url: "https://panel-a.example.com"
#     machine:
#       machine_id: 1
#       token: "token-a"
#   - panel:
#       url: "https://panel-b.example.com"
#     machine:
#       machine_id: 2
#       token: "token-b"
